# Copy to .env.test. Values here override .env when running `pnpm test`.
# Tests run against a separate database - never point this at your dev data.
NODE_ENV=test
DATABASE_URL="postgresql://pulsedesk:pulsedesk_dev_password@localhost:5432/pulsedesk_test"
DIRECT_URL="postgresql://pulsedesk:pulsedesk_dev_password@localhost:5432/pulsedesk_test"
