// PulseDesk — Prisma schema
// Multi-tenancy model: everything scopes via Company (site-id -> companyId)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AgentRole {
  ADMIN
  AGENT
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum ConversationSource {
  AI
  AGENT
}

enum MessageSender {
  CUSTOMER
  AGENT
  AI
}

// A company that has embedded the PulseDesk widget.
model Company {
  id       String @id @default(cuid())
  publicId String @unique @default(cuid())
  name     String
  siteId   String @unique // used in the embed script: data-site-id
  plan     String @default("free")
  settings Json?

  agents        Agent[]
  customers     Customer[]
  conversations Conversation[]
  faqDocs       FaqDoc[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

// A company-side user: either an ADMIN (manages company + agents) or AGENT (handles chats).
model Agent {
  id           String    @id @default(cuid())
  publicId     String    @unique @default(cuid())
  name         String
  email        String    @unique
  password     String
  role         AgentRole @default(AGENT)
  isActive     Boolean   @default(true)
  isOnline     Boolean   @default(false)
  tokenVersion Int       @default(0) // bumped to invalidate old JWTs (logout-all / password change)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assignedConversations Conversation[] @relation("AssignedAgent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("agents")
}

// Platform-level super-admin, oversees all companies. Seeded, not self-registered.
model SuperAdmin {
  id           String @id @default(cuid())
  publicId     String @unique @default(cuid())
  name         String
  email        String @unique
  password     String
  tokenVersion Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("super_admins")
}

// An anonymous end-customer (widget visitor) of a company. No login/password —
// identified by a client-generated externalId (e.g. persisted in the widget's
// localStorage) so repeat visits/conversations resolve back to the same person.
// Scoped per-company: the same browser talking to two different companies'
// widgets produces two separate Customer rows.
model Customer {
  id         String  @id @default(cuid())
  publicId   String  @unique @default(cuid())
  externalId String // widget-generated visitor id, persisted client-side
  name       String?
  email      String?
  metadata   Json? // arbitrary attributes the widget/company attaches (page URL, plan, custom fields, ...)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, externalId])
  @@index([companyId])
  @@index([companyId, email])
  @@map("customers")
}

// A single chat thread between an anonymous end-customer and a company (AI and/or agent).
model Conversation {
  id       String             @id @default(cuid())
  publicId String             @unique @default(cuid())
  status   ConversationStatus @default(OPEN)
  source   ConversationSource @default(AI)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  assignedAgentId String?
  assignedAgent   Agent?  @relation("AssignedAgent", fields: [assignedAgentId], references: [id])

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([customerId])
  @@index([assignedAgentId])
  @@map("conversations")
}

// A single message within a conversation.
model Message {
  id         String        @id @default(cuid())
  publicId   String        @unique @default(cuid())
  senderType MessageSender
  content    String

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("messages")
}

// A company's FAQ knowledge-base entry, used for embeddings + similarity search (RAG).
model FaqDoc {
  id       String @id @default(cuid())
  publicId String @unique @default(cuid())
  question String
  answer   String

  // Placeholder for the embedding vector until pgvector is wired up (Unsupported("vector") + raw SQL).
  embedding Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("faq_docs")
}
